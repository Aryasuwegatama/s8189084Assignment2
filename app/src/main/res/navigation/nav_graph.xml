<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.s8189084assignment2.ui.login.LoginFragment"
        android:label="@string/login_screen_label"
        tools:layout="@layout/fragment_login">

        <!-- If login succeeds, go to Dashboard and remove Login from the back stack,
             so the back button on Dashboard exits the app instead of returning to Login. -->
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.s8189084assignment2.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_screen_label"
        tools:layout="@layout/fragment_dashboard">

        <!-- The keypass from a successful login, used for every Dashboard API call. -->
        <argument
            android:name="keypass"
            app:argType="string" />

        <!-- Going to Details keeps Dashboard on the back stack, so back returns to the list. -->
        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.s8189084assignment2.ui.details.DetailsFragment"
        android:label="@string/details_screen_label"
        tools:layout="@layout/fragment_details">

        <!-- The sport tapped on Dashboard, carries every field this screen shows. -->
        <argument
            android:name="sport"
            app:argType="com.example.s8189084assignment2.data.model.Sport" />

    </fragment>

</navigation>
